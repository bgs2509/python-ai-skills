  "model": "opus",
  "enableAllProjectMcpServers": true,
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bd prime"
          },
          {
            "type": "command",
            "command": "echo 'WORKFLOW REMINDER: For dev features invoke feature-workflow. Flow: bd create → Discovery → [APPROVAL] → Brainstorming → [APPROVAL] → GRACE Ask → GRACE Plan → Q&A Contracts → Writing Plans → [APPROVAL] → Execution → Review → Finish → bd close'"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bd prime"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "{{CLAUDE_HOME}}/hooks/block-no-verify.sh"
          },
          {
            "type": "command",
            "command": "{{CLAUDE_HOME}}/hooks/rtk-rewrite.sh"
          },
          {
            "type": "command",
            "command": "{{CLAUDE_HOME}}/hooks/rtk-announce.sh"
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "echo '⚠️  REMINDER: When the subagent finishes, run an INDEPENDENT verifier (lint/test/schema-check) BEFORE reporting work as done. Subagent textual summary is not evidence of correctness — verify with the actual tool that consumes the artifact.'"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(jq -r \".tool_input.file_path // empty\"); case \"$f\" in *.xml) echo '⚠️  About to write XML. First-Contact Protocol: did you (1) check tool --help/--schema, (2) read its skill (e.g. grace-explainer/*-init), (3) verify any reference project passes that tool validation for the same version? Sibling-project schema is NOT canonical.' ;; esac"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "{{CLAUDE_HOME}}/hooks/regen-xml-on-spec-edit.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "{{CLAUDE_HOME}}/hooks/anti-hallucination.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "echo '\n\n╔═══════════════════════════════════════════════════════════════╗' && echo '║ 🔵 USER PROMPT DETECTED' && echo '╚═══════════════════════════════════════════════════════════════╝\n'",
            "timeout": 1
          },
          {
            "type": "command",
            "command": "input=$(cat); transcript=$(echo \"$input\" | jq -r '.transcript_path // empty'); if [ -n \"$transcript\" ] && [ -f \"$transcript\" ]; then turns=$(wc -l < \"$transcript\"); echo \"{\\\"systemMessage\\\": \\\"⚡ Сообщений в сессии: ${turns}\\\"}\"; fi",
            "timeout": 3
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "input=$(cat); proj=$(echo \"$input\" | jq -r '.workspace.project_dir // .cwd'); proj_name=\"$(basename \"$(dirname \"$proj\")\")/$(basename \"$proj\")\"; model=$(echo \"$input\" | jq -r '.model.display_name // \"unknown\"'); used=$(echo \"$input\" | jq -r '.context_window.used_percentage // empty'); ctx_str=\"\"; [ -n \"$used\" ] && ctx_str=\" | ctx: ${used}%\"; printf '\\033[36m[%s]\\033[0m %s%s' \"$proj_name\" \"$model\" \"$ctx_str\""
  },
  "language": "english",
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "network": {
      "allowUnixSockets": [
        "/var/run/docker.sock"
      ],
      "allowLocalBinding": true
    },
    "excludedCommands": [
      "git",
      "docker",
      "docker-compose"
    ]
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "autoUpdatesChannel": "latest",
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark-daltonized",
  "teammateMode": "tmux",
  "voiceEnabled": true
}
